generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inquires {
  id               Int      @id @default(autoincrement())
  inquiry_type     String
  name             String
  email            String
  phone            String
  subject          String
  message          String
  funding          String?
  attendees        String?
  course           String?
  service_interest String?
  project_scale    String?
  timeline         String?
  budget           String?
  project_desc     String?
  tech_specs       String?
  status           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Users {
  id            Int      @id @default(autoincrement())
  username      String
  password      String
  email         String
  role          String   @default("Student ")
  active_status Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Questions {
  id             Int    @id @default(autoincrement())
  module         String
  topic          String
  difficulty     String
  question_text  String
  choices        String
  correct_answer String
  explanation    String
}
